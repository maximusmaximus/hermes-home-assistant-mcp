[Unit]
Description=Home Assistant Real-Time Lifecycle Monitor and Telegram Notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/fleet/bin/ha-lifecycle-monitor.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
